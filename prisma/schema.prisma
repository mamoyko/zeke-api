// Zeke Mobile server — Postgres via Prisma.
//
// Three models, matching exactly what the services need: accounts, one row
// per person per day they've played the Daily Challenge, and one streak
// counter per person. Field names are camelCase (Prisma convention); `@map`
// keeps the actual Postgres columns snake_case.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  /// Public handle used to find someone without knowing their email.
  /// Lowercase, unique, allocated at signup — see src/utils/username.ts.
  username     String   @unique
  email        String   @unique
  /// null for a Google-only account — see users.service.ts.
  passwordHash String?  @map("password_hash")
  /// null for a local-only account. Unique so `findUnique({ where: { googleId } })` works.
  googleId     String?  @unique @map("google_id")
  createdAt    DateTime @default(now()) @map("created_at")

  /// In-game currency. Starts non-zero so a fresh account can send a Word
  /// Bounty immediately — see bounty.service.ts's SIGNUP_BONUS.
  balance Int @default(100)

  completions      DailyCompletion[]
  streak           Streak?
  sentBounties     Bounty[]          @relation("BountySender")
  receivedBounties Bounty[]          @relation("BountyRecipient")
  deviceTokens     DeviceToken[]
  playRewardDays   PlayRewardDay[]
  scoreRuns        ScoreRun[]
  friends          Friendship[]      @relation("FriendOwner")
  friendedBy       Friendship[]      @relation("FriendTarget")

  @@map("users")
}

/// One-way "I know this player" link, so the BOUNTY compose screen can offer
/// people you've added (or sent a word to) instead of retyping an address.
model Friendship {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  friendId  String   @map("friend_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User @relation("FriendOwner", fields: [userId], references: [id])
  friend User @relation("FriendTarget", fields: [friendId], references: [id])

  @@unique([userId, friendId])
  @@map("friendships")
}

/// One row per device that's registered for push notifications. A person can
/// have more than one (phone + tablet), so this is many-to-one on User, not
/// a column on it. `token` is unique on its own — if the same physical
/// device token shows up registered to a different user (a phone shared
/// between accounts, or a re-login), registerToken() in
/// push.service.ts re-points it rather than creating a duplicate row.
model DeviceToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  /// "android" | "ios" — informational; FCM sends work the same either way.
  platform  String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("device_tokens")
}

/// One row per person per day they've played the Daily Challenge. The
/// (userId, date) primary key is what makes "one shot per day" enforceable
/// server-side — see daily.service.ts.
model DailyCompletion {
  userId   String @map("user_id")
  /// UTC calendar day, "YYYY-MM-DD" — see src/data/dailyWords.ts's dayKey().
  date     String
  won      Boolean
  mistakes Int

  user User @relation(fields: [userId], references: [id])

  @@id([userId, date])
  @@map("daily_completions")
}

/// One row per person, tracking their Daily Challenge streak.
model Streak {
  userId  String @id @map("user_id")
  current Int    @default(0)
  longest Int    @default(0)
  /// The date of the last WIN counted toward the streak — deliberately not
  /// touched by a loss. See the reasoning in daily.service.ts's complete().
  lastCompletedDate String? @map("last_completed_date")

  user User @relation(fields: [userId], references: [id])

  @@map("streaks")
}

/// An asynchronous "send a hard word to a friend" challenge. The sender picks
/// a word from the Anime pool (src/data/anime-words.ts) and a wager; the
/// wager is deducted immediately. If the recipient fails, the sender gets
/// double the wager back. If the recipient solves it, the recipient takes
/// the sender's stake instead. See bounty.service.ts for the exact math.
model Bounty {
  id          String    @id @default(uuid())
  senderId    String    @map("sender_id")
  recipientId String    @map("recipient_id")
  word        String
  category    String
  wager       Int
  /// Paid to the sender if the recipient fails. Always `wager * 2` today,
  /// but stored (not recomputed) so a future balance formula change can't
  /// alter the payout of a bounty that's already in flight.
  reward      Int
  /// "pending" | "won" (recipient solved it) | "lost" (recipient failed)
  status      String    @default("pending")
  mistakes    Int?
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  sender    User @relation("BountySender", fields: [senderId], references: [id])
  recipient User @relation("BountyRecipient", fields: [recipientId], references: [id])

  @@map("bounties")
}

/// One row per person per UTC day, counting how many PLAY / PANIC wins have
/// already been paid out as coins. Caps live in play.service.ts — this table
/// is just the counter the cap is enforced against.
model PlayRewardDay {
  userId    String @map("user_id")
  /// UTC calendar day, "YYYY-MM-DD" — same unit as DailyCompletion.date.
  date      String
  playWins  Int    @default(0) @map("play_wins")
  panicWins Int    @default(0) @map("panic_wins")
  coins     Int    @default(0)

  user User @relation(fields: [userId], references: [id])

  @@id([userId, date])
  @@map("play_reward_days")
}

/// One finished NORMAL-mode run from the v2 game: rounds chained together
/// until the brain ran empty (or the player walked away). GLOBAL RANKING
/// ranks each player's single best run inside a period — see
/// play.service.ts's leaderboard().
model ScoreRun {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  score     Int
  rounds    Int
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@map("score_runs")
}
