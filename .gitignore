node_modules/
dist/
.env

# Firebase service account credentials — never commit these. Named to match
# FIREBASE_SERVICE_ACCOUNT_PATH's suggested default in .env.example, but
# ignored broadly in case yours is named differently.
firebase-service-account*.json
*-firebase-adminsdk-*.json

# Prisma's generated client — regenerated by `npm install` (postinstall) or
# `npx prisma generate`. prisma/migrations/ is NOT ignored: those are meant
# to be committed, they're the history of the schema.
generated/
