# Copy this file to .env (same folder) and adjust as needed. .env is
# gitignored; each person running the server keeps their own.

PORT=4000

# Signs session tokens (JWTs). The default below is fine for running this on
# your own machine to test with a teammate on the same network — change it to
# something random before this ever leaves a laptop.
JWT_SECRET=zeke-mobile-dev-secret-change-me

# Postgres. This default matches docker-compose.yml exactly — run
# `docker compose up -d` and this works with no further setup. Point it at a
# hosted Postgres (Neon, Supabase, RDS, ...) instead by changing this one line.
DATABASE_URL="postgresql://zeke:zeke@localhost:5433/zeke?schema=public"

# Optional — only needed for the "Continue with Google" button to work.
# Get these from Google Cloud Console (see ../zeke-mobile/auth/README.md for
# the five-minute walkthrough). The Godot client only ever sees
# GOOGLE_CLIENT_ID (client IDs are meant to be public); GOOGLE_CLIENT_SECRET
# stays here on the server and is never shipped inside the game.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — only needed to actually email someone when they receive a Word
# Bounty. Without it, bounties work exactly the same; the recipient just has
# to notice it in the app themselves. Get a free key at https://resend.com
# (100 emails/day on the free tier, no credit card).
RESEND_API_KEY=
# Leave this as-is to test with your OWN Resend account's email address only —
# onboarding@resend.dev is Resend's shared test domain, and it will only
# actually deliver to the address you signed up to Resend with (anyone else
# gets a 403). To notify real recipients, verify a domain you own in the
# Resend dashboard and put an address on that domain here instead — see
# README.md's "Email notifications" section.
MAIL_FROM="Zeke Mobile <onboarding@resend.dev>"

# Optional — only needed to send a real push notification (instantly, even if
# the game isn't open) the moment someone receives a Word Bounty. Without it,
# bounties still work exactly the same; the recipient only finds out from the
# email above (if that's configured) or by checking the app themselves.
# Path to a Firebase service account JSON key, downloaded from your own
# Firebase project's console (Project Settings → Service Accounts → Generate
# new private key). See README.md's "Push notifications" section for the
# full walkthrough, including the Godot-side plugin this pairs with.
# NEVER commit this file — see .gitignore.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
